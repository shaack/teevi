{
  "name": "teevi",
  "version": "2.7.0",
  "description": "Allows unit testing of ES6 modules without additional dependencies right in your browser.",
  "type": "module",
  "keywords": [
    "test",
    "unit test",
    "unittest",
    "ES6",
    "ECMAScript 6"
  ],
  "main": "src/teevi.js",
  "exports": {
    ".": "./src/teevi.js",
    "./src/*": "./src/*"
  },
  "bin": {
    "teevi": "bin/teevi.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node bin/teevi.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaack/teevi.git"
  },
  "author": "Stefan Haack (http://shaack.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shaack/teevi/issues"
  },
  "homepage": "https://github.com/shaack/teevi#readme"
}
